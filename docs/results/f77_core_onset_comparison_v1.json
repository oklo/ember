  "diagnostic_patch": "--- baseline.f\n+++ diagnostic.f\n@@ -358,6 +358,7 @@\n       PC=PP(1)**4\n       WRITE (6,521) NMOD,AGEYR,DTY2,NIT,XLSOL,RSOL,TEFF,T(1),RHOC,\n      1   PC,XH(1)\n+      CALL COREMON(NMOD,AGEYR)\n       IF (MOD(NMOD,NPRIN).EQ.0) CALL PRINTM\n C     THE STOPPING CONVENTION OF LB93 - THE SEQUENCE ENDS WHEN\n C     THE STAR HAS FADED BELOW A MILLIONTH OF THE SOLAR\n@@ -3653,3 +3654,23 @@\n C     COMPARISON WITH THE EQUILIBRIUM-CHAIN 1964 PROGRAM IN THE\n C     REPOSITORY ROOT.\n C     ------------------------------------------------------------------\n+\n+      SUBROUTINE COREMON(IMODEL,AGE)\n+      IMPLICIT DOUBLE PRECISION (A-H,O-Z)\n+      COMMON /GRID/ XI(201),EMPT(201),EMH(201),EMPH(201),N\n+      COMMON /VARBL/ R(201),F(201),T(201),Q(201),XH(201),X3A(201)\n+      COMMON /THRM2/ GADA(201),CPZ(201),DELZ(201)\n+      COMMON /FLAGS/ ICV(201)\n+      COMMON /CVEF/ PHIZ(201),GRZ(201),GRADZ(201),ICE(201)\n+      COMMON /STARP/ XM,XMI,ZMET,QHYD\n+      COREM=0.D0\n+      DO 10 J=1,N-1\n+      IF (ICV(J).NE.0) GO TO 20\n+      COREM=EMPT(J+1)/XM\n+   10 CONTINUE\n+   20 GAB=0.5D0*(GADA(1)+GADA(2))\n+      WRITE(6,900) IMODEL,AGE,XH(1),X3A(1),ICV(1),COREM,\n+     1 GRZ(1)/GAB,T(1),Q(1)**3,N\n+  900 FORMAT('EMBER_CORE ',I6,1P3E24.16,I3,1P4E24.16,I5)\n+      RETURN\n+      END\n",
