build/
.cache/
compile_commands.json
*.o
*.dSYM/
out/
__pycache__/
# New generated physics tables and raw source archives stay local. Keep the
# code, source patches, generation specifications and small provenance records.
# Files already present in published history remain tracked.
/data/**
!/data/**/
!/data/**/README.md
!/data/MANIFEST.json
!/data/production/provenance.json
!/data/production/configuration.txt
!/data/**/LICENSE*
!/data/**/SYNPLE-LICENSE
!/data/**/*.patch
!/data/**/*specification.json
!/data/**/*manifest.json
!/data/**/*.request.json
!/data/eos/sources/*parent_*.json
!/data/atmosphere/sources/synple-elements.json
!/data/atmosphere/sources/synspec-ap18-ions.dat
!/data/atmosphere/sources/condensate_free_energy_audit_states.json
!/data/atmosphere/sources/condensate_free_energy_survey_states.json
# Compact computed opacity and its source record, used by the cold-gas option.
!/data/opacity/cold_dense_hydrogen.dat
!/data/opacity/cold_dense_hydrogen.json

# Local restart binaries, raw histories and source-experiment recovery files.
# The report, its compact history CSV, figures and hash manifest are versioned.
/docs/reports/*/artifacts/
/docs/results/*.gz

# Agent coordination stays local; scientific methods and results belong in docs/.
/HANDOFF.md
/docs/PROJECT_STATUS.md
/docs/NEXT_SESSION_PROMPT.md
/docs/research/
