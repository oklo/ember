+
+      subroutine ember_eos_check
+c     Independent chemical density at each reported T and gas pressure.
+      INCLUDE 'IMPLIC.FOR'
+      INCLUDE 'BASICS.FOR'
+      INCLUDE 'MODELQ.FOR'
+      common/terden/rhoter,anta,entrp
+      do id=1,nd
+         an=dens(id)/wmm(id)+elec(id)
+         call eldens(id,temp(id),an,ane,enrg,entt,wm,0)
+         write(6,601) id,temp(id),an*bolk*temp(id),dens(id),rhoter
+      end do
+  601 format(' EMBER CHEMICAL DENSITY: ',i4,1p4e24.16)
+      return
+      end
