 C
 C =========================================================================
 
+
+C     Ember opacity sampling: source line/continuum kernels, prescribed
+C     wavelengths. Maximum 16 samples per continuum interpolation span.
+C     Requires complete in-memory line lists; no chunked list fallback.
+      SUBROUTINE EMBER_INISET
+      INCLUDE 'PARAMS.FOR'
+      INCLUDE 'MODELP.FOR'
+      INCLUDE 'SYNTHP.FOR'
+      INCLUDE 'LINDAT.FOR'
+      COMMON/LIMPAR/ALAM0,ALAM1,FRMIN,FRLAST,FRLI0,FRLIM
+      COMMON/BLAPAR/RELOP,SPACE0,CUTOF0,TSTD,DSTD,ALAMC
+      COMMON/GRIDF0/WLGRID(MFGRID),NFGRID
+      PARAMETER (CNM=2.997925D17,C18=2.997925D18)
+      SAVE INEXTFR
+      IF(ND.NE.1) STOP 'Ember sampling requires one material state'
+      IF(NXTSET.NE.0) STOP 'Ember sampling: atomic list incomplete'
+      DO ILIST=1,NMLIST
+         IF(NXTSEM(ILIST).NE.0)
+     *      STOP 'Ember sampling: molecular list incomplete'
+      END DO
+      IF(IBLANK.LE.1) INEXTFR=1
+      ISTART=INEXTFR
+      IEND=MIN(ISTART+15,NFGRID)
+      NFREQ=IEND-ISTART+3
+      NFREQS=NFREQ
+      DO IJ=3,NFREQ
+         FREQ(IJ)=C18/WLGRID(ISTART+IJ-3)
+      END DO
+      FREQ(1)=FREQ(3)
+      FREQ(2)=FREQ(NFREQ)
+      XX=FREQ(2)-FREQ(1)
+      IF(XX.GE.0.) STOP 'Ember sampling: invalid frequency span'
+      DO IJ=1,NFREQ
+         WLAM(IJ)=C18/FREQ(IJ)
+         FRX1(IJ)=(FREQ(IJ)-FREQ(1))/XX
+         FRX2(IJ)=(FREQ(2)-FREQ(IJ))/XX
+         W(IJ)=0.
+      END DO
+      W(1)=-XX/2.
+      W(2)=W(1)
+      FRMIN=FREQ(1)
+      FRMAX=FREQ(2)
+      ALA0=CNM/FRMIN
+      ALA1=CNM/FRMAX
+      SPACE=SPACE0*ALA0/ALAMC
+      SPAC=3.E16/ALA0/ALA0*SPACE
+      DFRCON=-(NFREQ-3)/XX
+      NLIN=0
+      IRLIST=0
+      DO IL=1,NLIN0
+         FR0=FREQ0(IL)
+         ALAM=CNM/FR0
+         IF(ALAM.LT.ALA0-CUTOF0) CYCLE
+         IF(ALAM.GT.ALA1+CUTOF0) EXIT
+         EXT=EXTIN(IL)
+         IF(FR0-FRMIN.GT.EXT+SPAC) CYCLE
+         IF(FRMAX-FR0.GT.EXT+SPAC) CYCLE
+         NLIN=NLIN+1
+         IF(NLIN.GT.MLIN) STOP 'Ember sampling: atomic set too big'
+         INDLIN(NLIN)=IL
+         INDLIP(NLIN)=IL
+         XJC=3.+DFRCON*(FREQ(1)-FR0)
+         IJC=INT(XJC)
+         IF(IJC.GT.3.AND.IJC.LT.NFREQ) THEN
+            IJC=3
+            DO IJ=4,NFREQ
+               IF(ABS(FREQ(IJ)-FR0).LT.ABS(FREQ(IJC)-FR0)) IJC=IJ
+            END DO
+         END IF
+         IJCNTR(NLIN)=IJC
+      END DO
+      CALL READPH
+      NBLANK=IBLANK+1
+      IF(IEND.EQ.NFGRID) NBLANK=IBLANK
+      INEXTFR=IEND
+      ALAM0=ALA1
+      ALAM1=ALA1
+      ALM00=ALA1
+      RETURN
+      END
